       IDENTIFICATION DIVISION.
       PROGRAM-ID. PAYROLL.
       AUTHOR. LEGACY-SYSTEMS-TEAM.

       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT EMP-FILE ASSIGN TO "EMPFILE.DAT"
               ORGANIZATION IS LINE SEQUENTIAL.
           SELECT PAY-FILE ASSIGN TO "PAYOUT.DAT"
               ORGANIZATION IS LINE SEQUENTIAL.

       DATA DIVISION.
       FILE SECTION.
       FD  EMP-FILE.
       01  EMP-RECORD.
           05 EMP-ID          PIC X(6).
           05 EMP-NAME        PIC X(30).
           05 EMP-DEPT        PIC X(4).
           05 EMP-SALARY-RAW  PIC 9(6)V99.

       FD  PAY-FILE.
       01  PAY-RECORD.
           05 PAY-EMP-ID      PIC X(6).
           05 PAY-NET-AMOUNT  PIC 9(6)V99.
           05 PAY-TAX-AMOUNT  PIC 9(6)V99.

       WORKING-STORAGE SECTION.
       01  WS-FLAGS.
           05 WS-EOF          PIC X VALUE 'N'.
           05 WS-STATUS       PIC 9(2) VALUE ZERO.

       01  WS-TOTALS.
           05 WS-TOTAL-NET    PIC 9(8)V99 VALUE ZERO.
           05 WS-TOTAL-TAX    PIC 9(8)V99 VALUE ZERO.

       01  WS-CALCULATION-DATA.
           05 WS-GROSS-PAY    PIC 9(6)V99.
           05 WS-TAX-RATE     PIC V999 VALUE .250.
           05 WS-TAX-DUE      PIC 9(6)V99.
           05 WS-NET-PAY      PIC 9(6)V99.

       01  WS-DEDUCTIONS-REDEFINED.
           05 WS-DED-PACKED   PIC X(8).
           05 WS-DED-NUMERIC REDEFINES WS-DED-PACKED PIC 9(8).

       01  WS-BENEFITS-TABLE.
           05 WS-BENEFIT-ITEM OCCURS 5 TIMES.
              10 BENEFIT-CODE PIC X(3).
              10 BENEFIT-AMT  PIC 9(4)V99.

       COPY "EMPREC.CPY".

       EXEC SQL INCLUDE SQLCA END-EXEC.

       PROCEDURE DIVISION.
       1000-MAIN-LOGIC.
           DISPLAY "STARTING PAYROLL BATCH PROCESSING"
           PERFORM 1100-INIT-ENVIRONMENT
           PERFORM 2000-PROCESS-PAYROLL THRU 2000-EXIT UNTIL WS-EOF = 'Y'
           PERFORM 3000-SUMMARY-REPORT
           PERFORM 4000-TERMINATE-PROGRAM
           STOP RUN.

       1100-INIT-ENVIRONMENT.
           OPEN INPUT EMP-FILE
           OPEN OUTPUT PAY-FILE
           MOVE 'N' TO WS-EOF
           PERFORM 1200-READ-NEXT-EMP.

       1200-READ-NEXT-EMP.
           READ EMP-FILE INTO EMP-RECORD
               AT END MOVE 'Y' TO WS-EOF
           END-READ.

       2000-PROCESS-PAYROLL.
           IF WS-EOF = 'Y'
               GO TO 2000-EXIT
           END-IF.

           COMPUTE WS-GROSS-PAY = EMP-SALARY-RAW

           EXEC SQL
               SELECT TAX_PERCENT INTO :WS-TAX-RATE
               FROM TAX_RATES
               WHERE DEPT_ID = :EMP-DEPT
           END-EXEC

           COMPUTE WS-TAX-DUE = WS-GROSS-PAY * WS-TAX-RATE
           COMPUTE WS-NET-PAY = WS-GROSS-PAY - WS-TAX-DUE

           PERFORM VARYING WS-STATUS FROM 1 BY 1 UNTIL WS-STATUS > 5
               ADD BENEFIT-AMT (WS-STATUS) TO WS-NET-PAY
           END-PERFORM

           CALL 'TAXCALC' USING BY REFERENCE WS-GROSS-PAY, WS-TAX-DUE

           MOVE EMP-ID TO PAY-EMP-ID
           MOVE WS-NET-PAY TO PAY-NET-AMOUNT
           MOVE WS-TAX-DUE TO PAY-TAX-AMOUNT

           WRITE PAY-RECORD

           ADD WS-NET-PAY TO WS-TOTAL-NET
           ADD WS-TAX-DUE TO WS-TOTAL-TAX

           PERFORM 1200-READ-NEXT-EMP.

       2000-EXIT.
           EXIT.

       3000-SUMMARY-REPORT.
           DISPLAY "TOTAL NET PAY: " WS-TOTAL-NET
           DISPLAY "TOTAL TAX: " WS-TOTAL-TAX.

       4000-TERMINATE-PROGRAM.
           CLOSE EMP-FILE
           CLOSE PAY-FILE.
